# MATLAB MCP Server 统一环境配置
# ================================
# 所有脚本从此文件读取路径配置，避免硬编码散布各处。
# 部署时只需修改此文件即可适配不同机器。

# MATLAB 项目工作目录
MATLAB_WORKING_DIR=E:\code\Paper2

# MCP Server 安装目录
MCP_SERVER_DIR=E:\code\WinServerBuild

# Python 路径（Windows）
PYTHON_PATH=C:\Python310\python.exe

# 网络配置
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Tailscale IP（Windows 端，用于 Mac 连接）
# 在 Tailscale 管理面板查看: https://login.tailscale.com/admin/machines
TAILSCALE_IP=100.x.y.z

# 资源监控阈值
CPU_THRESHOLD=90
MEMORY_THRESHOLD=85
DISK_THRESHOLD=95
MAX_QUEUE_SIZE=5
MAX_RUNNING_TASKS=1

# 认证（留空=不启用，强烈建议设置）
MCP_TOKEN=

# 日志
LOG_DIR=E:\code\WinServerBuild\logs
