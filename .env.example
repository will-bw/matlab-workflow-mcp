# MATLAB MCP Server 统一环境配置（模板）
# ================================
# 使用方法：复制本文件为 .env 并填写实际值：
#   cp .env.example .env
# 所有脚本从此文件读取路径配置，避免硬编码散布各处。
# 注意：.env 已被 Git 忽略，切勿提交真实凭证。

# MATLAB 项目工作目录
MATLAB_WORKING_DIR=E:\code\Paper2

# Python 路径（Windows）
PYTHON_PATH=

# 网络配置
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Tailscale IP（Windows 端，用于 Mac 连接）
# 在 Tailscale 管理面板查看: https://login.tailscale.com/admin/machines
TAILSCALE_IP=

# 资源监控阈值
CPU_THRESHOLD=90
MEMORY_THRESHOLD=90
DISK_THRESHOLD=95
# 16GB 内存机器建议 2（3 并发易触发内存耗尽导致 MATLAB 堆损坏崩溃）
MAX_CONCURRENT_TASKS=2
MAX_QUEUE_SIZE=5
# 可用内存低于此值(GB)时不启动新 MATLAB 进程
MIN_FREE_MEMORY_GB=4

# 认证（留空=不启用，强烈建议设置）
# 设置后客户端必须在请求头携带: Authorization: Bearer <token>
MCP_TOKEN=

# Mac 端脚本使用的服务器地址（fetch_results.sh / sync_and_run.sh / mcp_cli.py）
# 填入 Windows 端地址，端口与 MCP_PORT 一致
MCP_URL=http://100.64.0.0:8080

# 日志
LOG_DIR=